{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skyblock Tracker",
  "version": "1.0.2",
  "identifier": "com.skyblocktracker.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Skyblock Tracker",
        "width": 1360,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false,
        "backgroundColor": "#0d0c12",
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' https://api.hypixel.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3OTk1MTM4QjQ5RjMyNjMKUldSak1wKzBPRkdaZHh3OC9CTGFqUnJzNmpuWW9MZUpRK3oyMnJrTjAvckpSV2lMUFJHellTY0MK",
      "endpoints": [
        "https://github.com/AlphaGenesis/SkyblockTracker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
